rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny Root Access
    match /{document=**} {
      allow read, write: if false;
    }

    // Strict User-Isolated Domain Hierarchy
    match /users/{userId} {
      // Direct user document
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Profile subcollection
      match /profile/{profileId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Expenses subcollection
      match /expenses/{expenseId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Assets subcollection
      match /assets/{assetId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Financial Transactions subcollection
      match /transactions/{transactionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Uploaded Documents subcollection
      match /documents/{documentId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // What-If Scenarios subcollection
      match /scenarios/{scenarioId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Household Insights subcollection
      match /insights/{insightId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Copilot Conversations subcollection
      match /conversations/{conversationId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Catch-all for any other nested subcollections under user domain
      match /{allSubPaths=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}

